 {
  "id": "vllm",
  "name": "vLLM",
  "vendor": "vLLM project",
  "kind": "sidecar",
  "description": "Serving ad alto throughput con PagedAttention e batching continuo. Su Windows tramite WSL2.",
  "platforms": [
   "linux"
  ],
  "accelerators": [
   "cuda",
   "rocm",
   "sycl",
   "cpu"
  ],
  "formats": [
   "safetensors",
   "awq",
   "gptq",
   "fp8",
   "gguf"
  ],
  "capabilities": [
   "chat",
   "tools",
   "vision",
   "embeddings",
   "grammar"
  ],
  "detect": {
   "binaries": [
    "vllm"
   ],
   "python_modules": [
    "vllm"
   ]
  },
  "launch": {
   "command": "vllm",
   "args": [
    "serve",
    "{model}",
    "--host",
    "127.0.0.1",
    "--port",
    "{port}"
   ],
   "settings_args": {
    "gpu_memory_utilization": [
     "--gpu-memory-utilization",
     "{value}"
    ],
    "max_model_len": [
     "--max-model-len",
     "{value}"
    ],
    "tensor_parallel_size": [
     "--tensor-parallel-size",
     "{value}"
    ],
    "quantization": [
     "--quantization",
     "{value}"
    ],
    "tool_parser": [
     "--enable-auto-tool-choice",
     "--tool-call-parser",
     "{value}"
    ],
    "extra_args": []
   },
   "health": "/health",
   "ready_timeout_s": 900,
   "requires_model": true
  },
  "settings": {
   "type": "object",
   "properties": {
    "gpu_memory_utilization": {
     "type": "number",
     "title": "Uso memoria GPU",
     "default": 0.9,
     "minimum": 0.1,
     "maximum": 0.98,
     "step": 0.01
    },
    "max_model_len": {
     "type": "integer",
     "title": "Lunghezza massima",
     "default": 32768,
     "minimum": 1024,
     "maximum": 1048576
    },
    "tensor_parallel_size": {
     "type": "integer",
     "title": "Tensor parallel (GPU)",
     "default": 1,
     "minimum": 1,
     "maximum": 16
    },
    "quantization": {
     "type": "string",
     "title": "Quantizzazione",
     "enum": [
      "auto",
      "awq",
      "gptq",
      "fp8",
      "bitsandbytes"
     ],
     "default": "auto"
    },
    "tool_parser": {
     "type": "string",
     "title": "Parser tool calling",
     "enum": [
      "hermes",
      "llama3_json",
      "mistral",
      "qwen3_coder",
      "pythonic"
     ],
     "default": "hermes"
    },
    "binary": {
     "type": "string",
     "title": "Percorso dell'eseguibile",
     "description": "Lascia vuoto per cercarlo nel PATH",
     "default": "",
     "advanced": true
    },
    "port": {
     "type": "integer",
     "title": "Porta (0 = automatica)",
     "default": 0,
     "minimum": 0,
     "maximum": 65535,
     "advanced": true
    },
    "extra_args": {
     "type": "array",
     "title": "Argomenti extra",
     "items": {
      "type": "string"
     },
     "default": [],
     "advanced": true
    }
   }
  },
  "install": {
   "linux": "pip install vllm",
   "windows": "wsl -- pip install vllm"
  },
  "homepage": "https://github.com/vllm-project/vllm",
  "api": "openai"
 },
