[
 {
  "id": "llama-server",
  "name": "llama.cpp server",
  "vendor": "ggml-org",
  "kind": "sidecar",
  "description": "Server OpenAI-compatibile di llama.cpp: CPU, CUDA, ROCm, Metal, Vulkan, SYCL. AIW lo avvia e lo supervisiona.",
  "platforms": [
   "windows",
   "macos",
   "linux"
  ],
  "accelerators": [
   "cpu",
   "cuda",
   "rocm",
   "metal",
   "vulkan",
   "sycl",
   "opencl"
  ],
  "formats": [
   "gguf"
  ],
  "capabilities": [
   "chat",
   "tools",
   "vision",
   "embeddings",
   "grammar"
  ],
  "detect": {
   "binaries": [
    "llama-server"
   ]
  },
  "launch": {
   "command": "llama-server",
   "args": [
    "--host",
    "127.0.0.1",
    "--port",
    "{port}",
    "-m",
    "{model_path}",
    "--jinja"
   ],
   "settings_args": {
    "ctx_size": [
     "-c",
     "{value}"
    ],
    "gpu_layers": [
     "-ngl",
     "{value}"
    ],
    "threads": [
     "-t",
     "{value}"
    ],
    "flash_attn": [
     "--flash-attn",
     "on"
    ],
    "cache_type": [
     "-ctk",
     "{value}",
     "-ctv",
     "{value}"
    ],
    "parallel": [
     "-np",
     "{value}"
    ],
    "mmproj": [
     "--mmproj",
     "{value}"
    ],
    "rpc_servers": [
     "--rpc",
     "{value}"
    ],
    "extra_args": []
   },
   "health": "/health",
   "requires_model": true
  },
  "settings": {
   "type": "object",
   "properties": {
    "ctx_size": {
     "type": "integer",
     "title": "Finestra di contesto",
     "default": 8192,
     "minimum": 512,
     "maximum": 1048576,
     "step": 512
    },
    "gpu_layers": {
     "type": "integer",
     "title": "Layer su GPU",
     "description": "999 = tutto su GPU, 0 = solo CPU",
     "default": 999,
     "minimum": 0,
     "maximum": 999
    },
    "threads": {
     "type": "integer",
     "title": "Thread CPU",
     "description": "vuoto = automatico",
     "minimum": 1,
     "maximum": 256
    },
    "flash_attn": {
     "type": "boolean",
     "title": "Flash attention",
     "default": true
    },
    "cache_type": {
     "type": "string",
     "title": "Quantizzazione KV cache",
     "enum": [
      "f16",
      "q8_0",
      "q4_0"
     ],
     "default": "f16"
    },
    "parallel": {
     "type": "integer",
     "title": "Slot paralleli",
     "default": 1,
     "minimum": 1,
     "maximum": 64,
     "advanced": true
    },
    "mmproj": {
     "type": "string",
     "title": "Proiettore multimodale (mmproj)",
     "default": "",
     "advanced": true
    },
    "rpc_servers": {
     "type": "string",
     "title": "Worker RPC (host:porta,…) per inferenza distribuita",
     "default": "",
     "advanced": true
    },
    "binary": {
     "type": "string",
     "title": "Percorso dell'eseguibile",
     "description": "Lascia vuoto per cercarlo nel PATH",
     "default": "",
     "advanced": true
    },
    "port": {
     "type": "integer",
     "title": "Porta (0 = automatica)",
     "default": 0,
     "minimum": 0,
     "maximum": 65535,
     "advanced": true
    },
    "extra_args": {
     "type": "array",
     "title": "Argomenti extra",
     "items": {
      "type": "string"
     },
     "default": [],
     "advanced": true
    }
   }
  },
  "install": {
   "windows": "winget install llama.cpp",
   "macos": "brew install llama.cpp",
   "linux": "brew install llama.cpp · oppure release ggml-org/llama.cpp"
  },
  "homepage": "https://github.com/ggml-org/llama.cpp",
  "api": "openai"
 },
 {
  "id": "ollama",
  "name": "Ollama",
  "vendor": "Ollama",
  "kind": "sidecar",
  "api": "ollama",
  "description": "Usa un server Ollama già attivo oppure lo avvia (`ollama serve`). Modelli gestiti con `ollama pull`.",
  "platforms": [
   "windows",
   "macos",
   "linux"
  ],
  "accelerators": [
   "cpu",
   "cuda",
   "rocm",
   "metal",
   "vulkan"
  ],
  "formats": [
   "gguf"
  ],
  "capabilities": [
   "chat",
   "tools",
   "vision",
   "embeddings"
  ],
  "detect": {
   "binaries": [
    "ollama"
   ]
  },
  "external_endpoint": "http://127.0.0.1:11434/v1",
  "launch": {
   "command": "ollama",
   "args": [
    "serve"
   ],
   "env": {
    "OLLAMA_HOST": "127.0.0.1:{port}"
   },
   "health": "/api/version"
  },
  "settings": {
   "type": "object",
   "properties": {
    "binary": {
     "type": "string",
     "title": "Percorso dell'eseguibile",
     "description": "Lascia vuoto per cercarlo nel PATH",
     "default": "",
     "advanced": true
    },
    "port": {
     "type": "integer",
     "title": "Porta (0 = automatica)",
     "default": 0,
     "minimum": 0,
     "maximum": 65535,
     "advanced": true
    },
    "keep_alive": {
     "type": "string",
     "title": "Keep alive",
     "default": "5m",
     "advanced": true
    }
   }
  },
  "install": {
   "any": "https://ollama.com/download"
  },
  "homepage": "https://ollama.com"
 },
