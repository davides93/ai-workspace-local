{
  "name": "@aiw/ui",
  "private": true,
  "version": "0.5.0-beta.9",
  "type": "module",
  "description": "AI Workspace Local – shared UI for desktop, mobile and web (React + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-no-external.mjs dist",
    "build:mockup": "tsc -b && vite build --mode mockup && node scripts/check-no-external.mjs dist-mockup",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.e2e.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "check:offline": "node scripts/check-no-external.mjs dist dist-mockup",
    "i18n:scan": "node scripts/i18n-scan.mjs",
    "test:e2e": "playwright test --project=e2e --trace off",
    "test:a11y": "playwright test --project=a11y --trace off",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "bench:startup": "node scripts/bench-startup.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.7",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "5.0.4"
  }
}
