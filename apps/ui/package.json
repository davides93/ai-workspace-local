{
  "name": "@aiw/ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "AI Workspace Local – shared UI for desktop, mobile and web (React + Vite)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:mockup": "tsc -b && vite build --mode mockup",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.2",
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "playwright": "1.63.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "5.0.4"
  }
}
