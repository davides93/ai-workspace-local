{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Workspace Local",
  "version": "0.5.0-beta.2",
  "identifier": "dev.aiworkspace.local",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "title": "AI Workspace Local",
        "width": 1360,
        "height": 880,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Workspace AI locale con agenti, runtime e modelli sul tuo dispositivo",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "version": "0.5.0.2"
      }
    },
    "android": {
      "minSdkVersion": 26,
      "versionCode": 5002
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "bundleVersion": "5002"
    },
    "iOS": {
      "minimumSystemVersion": "17.0",
      "bundleVersion": "5002"
    }
  }
}
